# Disable directory browsing (prevent URL server surfing)
Options -Indexes

# Deny access to sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(glaz env\.txt|session\.txt|database_setup\.sql|\.env)$">
    Require all denied
</FilesMatch>

# Enforce robots.txt rules by sending X-Robots-Tag header
<IfModule mod_headers.c>
    # Prevent indexing of restricted directories
    <DirectoryMatch "^.*/(api|admin|police|database|includes|common)/">
        Header set X-Robots-Tag "noindex, nofollow"
    </DirectoryMatch>
    
    # Prevent indexing of any PHP files
    <FilesMatch "\.php$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>
