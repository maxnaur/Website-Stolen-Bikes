# Disable directory browsing (prevent URL server surfing)
Options -Indexes

# Deny access to sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(glaz env\.txt|session\.txt|database_setup\.sql|\.env)$">
    Require all denied
</FilesMatch>

# Enforce robots.txt rules by sending X-Robots-Tag header
<IfModule mod_headers.c>
    # Prevent indexing of restricted directories
    <DirectoryMatch "^.*/(api|admin|police|database|includes|common)/">
        Header set X-Robots-Tag "noindex, nofollow"
    </DirectoryMatch>
    
    # Prevent indexing of any PHP files
    <FilesMatch "\.php$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
    
    # Cookie Integration: Force HttpOnly, Secure, and SameSite=Strict on all Set-Cookie headers emitted by the server
    Header edit Set-Cookie ^(.*)$ "$1; HttpOnly; Secure; SameSite=Strict"
</IfModule>

# Token Integration: Ensure custom headers (like CSRF tokens or Authorization) are passed to PHP environments
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    RewriteCond %{HTTP:X-CSRF-TOKEN} ^(.*)
    RewriteRule .* - [e=HTTP_X_CSRF_TOKEN:%1]
</IfModule>

# Session Cookie Hardening for PHP (if mod_php is used)
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_value session.cookie_samesite Strict
    php_value session.use_strict_mode 1
    php_flag session.use_only_cookies on
</IfModule>
